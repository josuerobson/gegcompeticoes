# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# DATABASE_URL: Postgres connection string. Required — the app refuses to start without it.
DATABASE_URL="postgresql://user:password@localhost:5432/gegcompeticoes"

# DATABASE_SSL: set to "true" only if your Postgres server requires SSL (the internal
# EasyPanel-hosted Postgres for this project does not).
DATABASE_SSL="false"

# MinIO (S3-compatible object storage) for member/club document uploads (RG/CNH, CR,
# Declaração de filiação, Cartão CNPJ, Alvará). Optional in local dev — upload endpoints
# return a clear error instead of crashing when unset.
MINIO_ENDPOINT="localhost"
MINIO_PORT="9000"
MINIO_USE_SSL="false"
MINIO_ACCESS_KEY=""
MINIO_SECRET_KEY=""
MINIO_BUCKET="gegcompeticoes-docs"

# ---------------------------------------------------------------------------
# EasyPanel � deploy e monitoramento (usado por agentes de IA, nao pelo app)
# ---------------------------------------------------------------------------
# URL base do painel EasyPanel onde o projeto esta hospedado.
EASYPANEL_URL="https://5450wp.easypanel.host"

# API key do EasyPanel. Gere em: EasyPanel > Settings > API Keys.
# Usada por IAs para disparar deploys e consultar logs sem acesso ao painel web.
# NUNCA commitar o valor real � este arquivo eh apenas o template.
EASYPANEL_API_KEY=""

# Nome do projeto e servico no EasyPanel (necessario para montar as chamadas de API).
EASYPANEL_PROJECT="gegcompeticoes"
EASYPANEL_SERVICE="web"
